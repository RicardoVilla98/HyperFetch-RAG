# ==============================================================================
# HyperFetch-RAG: Environment Configuration Template
# Copy this file to .env and provide your actual secrets.
# ==============================================================================

# OpenAI API Configuration
OPENAI_API_KEY=sk-proj-yourOpenAISecretKeyHere
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536

# Qdrant Vector Database Configuration
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=hyperfetch_knowledge_base

# Reranker Model (HuggingFace sentence-transformers)
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
USE_RERANKER=true

# Document Ingestion & Chunking Parameters
CHUNK_SIZE=800
CHUNK_OVERLAP=150
MAX_UPLOAD_SIZE_MB=50

# Retrieval & Hybrid Search Tuning
TOP_K_DENSE=15
TOP_K_SPARSE=15
TOP_K_FINAL=5
HYBRID_ALPHA=0.5
RECIPROCAL_RANK_K=60

# FastAPI Application Settings
APP_NAME=HyperFetch-RAG
APP_VERSION=1.0.0
APP_ENV=production
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
